# Merged on top of x86_64 defconfig + kvm_guest.config
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EXT4_FS=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_R8169=y
CONFIG_IGB=y
CONFIG_PACKET=y
CONFIG_MODULES=y
# ponytail: no sound/wifi/bluetooth/usb-storage; add when a target box needs them
CONFIG_SOUND=n
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_BT=n
CONFIG_DEBUG_INFO_NONE=y
# UEFI: the kernel is its own bootloader (EFI stub), initramfs + cmdline built in
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=tty0 console=ttyS0 loglevel=1 vt.global_cursor_default=0"
# disks: Proxmox virtio-scsi / sata, bare-metal nvme
CONFIG_SCSI_VIRTIO=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
# screen: firmware framebuffer for the TUI on tty1
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# /dev/fb0: the TUI paints itself on the framebuffer (aios/src/fb.rs)
CONFIG_FB_DEVICE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
# install media: CD-ROM (iso9660, sr) is in defconfig; fast USB sticks need UAS
CONFIG_USB_UAS=y
